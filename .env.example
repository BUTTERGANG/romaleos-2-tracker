# ROMALEOS 2 Tracker — Environment Configuration
# Copy this to .env and fill in your values

# === eBay API (REQUIRED for live listings) ===
# Get these from https://developer.ebay.com/
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here
EBAY_MARKETPLACE=EBAY_US
EBAY_CURRENCY=USD
EBAY_SITE_ID=0

# === Discord (OPTIONAL — for price alerts) ===
# Create a webhook in your Discord server channel:
#   Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# === App Settings ===
SECRET_KEY=change-me-to-a-random-secret
PORT=8003
HOST=0.0.0.0

# === Scheduler ===
# How often to poll eBay for new listings (minutes)
POLL_INTERVAL_MINUTES=30

# === Default Search ===
# Override the default eBay search query
SEARCH_QUERY=Nike Romaleos 2