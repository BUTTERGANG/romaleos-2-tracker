# ROMALEOS 2 Tracker — Environment Configuration
# Copy this to .env and fill in your values. Loaded automatically via python-dotenv.

# === eBay API (REQUIRED for live listings) ===
# Get these from https://developer.ebay.com/  (aliases: APP_ID / CERT_ID)
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here
EBAY_MARKETPLACE=EBAY_US
EBAY_CURRENCY=USD
# User-Agent sent on eBay API requests
# EBAY_USER_AGENT=romaleos-2-tracker/1.0 (+https://github.com/BUTTERGANG/romaleos-2-tracker)

# === Discord (OPTIONAL — for price alerts) ===
# Incoming webhook (not a bot). Server Settings -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL. Individual watches can override this in the UI.
DISCORD_WEBHOOK_URL=

# === App Settings ===
SECRET_KEY=change-me-to-a-random-secret
HOST=0.0.0.0
PORT=5000

# === Scheduler ===
# How often to poll eBay for new listings (minutes). Also polls once on startup.
POLL_INTERVAL_MINUTES=30

# === Default Search ===
# Base query. Free-text search in the UI refines *within* this query.
SEARCH_QUERY=Nike Romaleos 2

# === Data freshness / eBay API compliance ===
# Hide listings not re-seen within N hours (eBay: displayed data must be < 6h old)
LISTING_STALE_HOURS=6
# Delete listings not re-seen within N hours (eBay: remove unavailable items)
LISTING_PURGE_HOURS=24
# Min seconds between page-load-triggered eBay calls, per query+sort
# (protects the Browse API's 5,000 calls/day budget)
LIVE_SEARCH_CACHE_SECONDS=120
